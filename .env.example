# URL of your deployed Google Apps Script web app (see google-apps-script.js).
# Copy this file to .env and fill in the value — the signup popup posts here.
VITE_GOOGLE_SCRIPT_URL=

# Base URL of the Surwive backend API (jobportal/server). Jobs & internships on
# the site are fetched from GET {VITE_API_BASE}/api/portal/jobs.
# Defaults to http://localhost:5001 when unset.
VITE_API_BASE=http://localhost:5001
